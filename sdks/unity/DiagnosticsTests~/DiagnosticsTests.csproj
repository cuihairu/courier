<Project Sdk="Microsoft.NET.Sdk">

  <!-- 批次 8 diagnostics 可选包纯逻辑单测:dotnet test,不依赖 Unity 运行时。
       被测源码 = Core(Runtime 去 Adapter)+ Diagnostics 包全量;本地极简 FakeTransport
       (诊断直发端点不经 CourierClient/网关,不共享 CoreTests~/Fakes.cs)。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>Courier.DiagnosticsTests</AssemblyName>
    <RootNamespace>Courier.DiagnosticsTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../packages/com.courier.core/Runtime/*.cs" />
    <Compile Include="../packages/com.courier.core/Runtime/Core/*.cs" />
    <Compile Include="../packages/com.courier.core/Runtime/Core/Contract/*.cs" />
    <Compile Include="../packages/com.courier.core/Runtime/Identity/*.cs" />
    <Compile Include="../packages/com.courier.core/Runtime/Session/*.cs" />
    <Compile Include="../packages/com.courier.diagnostics/Runtime/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
