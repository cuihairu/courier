<Project Sdk="Microsoft.NET.Sdk">

  <!-- 批次 4 Unity Core 纯逻辑单测:dotnet test,不依赖 Unity 运行时。
       ~ 后缀 Unity 不导入;被测源码经 Compile Include 参与(netstandard2.1 兼容子集)。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>Courier.CoreTests</AssemblyName>
    <RootNamespace>Courier.CoreTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Runtime/*.cs" />
    <Compile Include="../Runtime/Core/*.cs" />
    <Compile Include="../Runtime/Core/Contract/*.cs" />
    <Compile Include="../Runtime/Identity/*.cs" />
    <Compile Include="../Runtime/Session/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
